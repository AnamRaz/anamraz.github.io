---
import type { Project } from '../content/site';
interface Props {
  project: Project;
  index: number;
}
const { project, index } = Astro.props;
---

<article class="project-card">
  <div class="project-card__top">
    <span class="project-card__index" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
    <p class="eyebrow">{project.eyebrow}</p>
    <span class="status">{project.status}</span>
  </div>
  <div class="project-card__body">
    <div>
      <h3>{project.title}</h3>
      <p class="project-card__summary">{project.problem}</p>
      <ul class="tech-list" aria-label={`${project.title} technologies`}>
        {project.technologies.map((technology) => <li>{technology}</li>)}
      </ul>
    </div>
    <dl class="project-card__details">
      <dt>My contribution</dt>
      <dd>{project.contribution}</dd>
      <dt>{project.outcomeLabel}</dt>
      <dd>{project.outcome}</dd>
    </dl>
  </div>
</article>
