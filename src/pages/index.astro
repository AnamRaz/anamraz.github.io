---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { earlierExperience, education, experience, projects, site, skillGroups } from '../content/site';
---

<BaseLayout>
  <section class="hero shell" id="top" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="eyebrow">Enterprise applications & integrations</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="hero__role">{site.headline}</p>
      <p class="hero__intro">{site.introduction}</p>
      <div class="hero__actions">
        <a class="button button--primary" href={site.links.resume} download>Download résumé <span aria-hidden="true">↓</span></a>
        <a class="button" href="#work">View selected work <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={`mailto:${site.email}`}>Email <span aria-hidden="true">↗</span></a>
      </div>
      <div class="hero__profiles">
        <span>{site.location}</span>
        <a href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href={site.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section experience" id="experience" aria-label="Professional experience">
    <div class="shell">
      <SectionHeading eyebrow="Experience" title="Building and supporting enterprise software." />
      <div class="experience-list">
        {experience.map((job) => (
          <article class="experience-entry">
            <div class="experience-entry__meta">
              <p class="experience-entry__dates">{job.dates}</p>
              <h3>{job.title}</h3>
              <p class="experience-entry__employer">{job.employer}</p>
              <p class="experience-entry__context">{job.context}</p>
            </div>
            <ul>{job.contributions.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
      <p class="earlier-experience">{earlierExperience}</p>
    </div>
  </section>

  <section class="section shell work" id="work" aria-label="Selected work">
    <SectionHeading eyebrow="Selected work" title="Modernization, automation, and product development." />
    <div class="project-list">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <section class="section expertise" id="expertise" aria-label="Technical skills">
    <div class="shell">
      <SectionHeading eyebrow="Technical skills" title="A focused engineering toolkit." />
      <div class="skills-grid">
        {skillGroups.map((group) => (
          <article>
            <h3>{group.title}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section shell education" id="education" aria-labelledby="education-title">
    <p class="eyebrow">Education</p>
    <div>
      <h2 id="education-title">{education.degree}</h2>
      <p>{education.school} · {education.location}</p>
      <p class="education__date">{education.date}</p>
    </div>
  </section>

  <section class="contact" id="contact" aria-labelledby="contact-title">
    <div class="shell contact__inner">
      <div>
        <p class="eyebrow">Contact</p>
        <h2 id="contact-title">Let’s talk engineering.</h2>
        <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>
      </div>
      <div class="contact__actions">
        <a class="button button--light" href={`mailto:${site.email}`}>Email <span aria-hidden="true">↗</span></a>
        <a class="text-link text-link--light" href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a class="text-link text-link--light" href={site.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <footer class="footer">
    <div class="shell footer__inner">
      <div>
        <p>© {new Date().getFullYear()} {site.name}</p>
        <p>{site.headline}</p>
      </div>
      <a href="#top">Back to top ↑</a>
    </div>
  </footer>
</BaseLayout>
