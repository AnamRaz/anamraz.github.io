---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { caseStudy, impactAreas, projects, site, skillGroups } from '../content/site';

const isConfigured = (value: string) => !value.startsWith('xxxxxxxxx');
---

<BaseLayout>
  <section class="hero shell" id="top" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="hero__kicker"><span></span>{site.role}</p>
      <h1 id="hero-title">Software that works<br />where business gets <em>complex.</em></h1>
      <p class="hero__intro">
        I design and deliver production systems using .NET, Blazor, Angular, Azure, SQL Server,
        enterprise integrations, and AI-enabled workflows.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="#work">View my work <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={site.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        {isConfigured(site.links.linkedin)
          ? <a class="text-link" href={site.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
          : <span class="text-link text-link--disabled" title="Add the LinkedIn URL in src/content/site.ts">LinkedIn <span aria-hidden="true">↗</span></span>}
      </div>
    </div>
    <aside class="hero__note" aria-label="Professional focus">
      <p>Currently focused on</p>
      <strong>Enterprise modernization, pragmatic architecture, and building Stockward.</strong>
      <span>Based in the United States · Working across systems, product, and delivery.</span>
    </aside>
  </section>

  <section class="positioning" aria-label="Engineering focus">
    <div class="shell positioning__grid">
      {impactAreas.map((area) => (
        <article>
          <span>{area.number}</span>
          <h2>{area.title}</h2>
          <p>{area.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell about" id="about">
    <SectionHeading eyebrow="About" title="Engineering judgment grounded in production reality." />
    <div class="about__content">
      <p class="about__lead">
        I build enterprise applications and cloud-based systems where technical decisions need to
        hold up against real workflows, real integrations, and real operational pressure.
      </p>
      <div class="about__details">
        <p>
          My work spans .NET and Azure services, Blazor and Angular frontends, SQL-backed workflows,
          and business-system development involving JDE and other enterprise integrations. I’m
          comfortable moving between architecture, implementation, production troubleshooting, and
          performance improvement.
        </p>
        <p>
          I’m also building Stockward, a SaaS product for multi-location restaurant operations.
          Product ownership sharpens how I think about scope, maintainability, customer value, and
          the compounding cost of unclear decisions.
        </p>
      </div>
    </div>
  </section>

  <section class="section work" id="work">
    <div class="shell">
      <SectionHeading
        eyebrow="Selected work"
        title="Systems, products, and engineering foundations."
        description="A focused view of the problems I take on. Employer and customer details are intentionally sanitized."
      />
      <div class="project-list">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section shell case-study" id="case-study">
    <SectionHeading eyebrow="Case study · Sanitized" title={caseStudy.title} description={caseStudy.intro} />
    <div class="case-study__grid">
      {caseStudy.sections.map((section, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{section.label}</h3>
          <p>{section.content}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section expertise" id="expertise">
    <div class="shell">
      <SectionHeading
        eyebrow="Expertise"
        title="A practical toolkit for durable software."
        description="Technology matters most in the context of sound boundaries, safe delivery, and clear business outcomes."
      />
      <div class="skills-grid">
        {skillGroups.map((group, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{group.title}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="contact shell" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">Start a conversation</p>
    <h2 id="contact-title">Building something that needs to work <em>for the long haul?</em></h2>
    <p>
      I’m interested in senior engineering, technical leadership, architecture, and thoughtful
      consulting conversations.
    </p>
    <div class="contact__actions">
      {isConfigured(site.links.contact)
        ? <a class="button button--light" href={site.links.contact}>Get in touch <span aria-hidden="true">↗</span></a>
        : <span class="button button--light button--disabled" title="Add a contact URL in src/content/site.ts">Contact link coming soon</span>}
      <a class="text-link text-link--light" href={site.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      {isConfigured(site.links.linkedin)
        ? <a class="text-link text-link--light" href={site.links.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a>
        : <span class="text-link text-link--light text-link--disabled">LinkedIn</span>}
    </div>
  </section>

  <footer class="footer">
    <div class="shell footer__inner">
      <div>
        <a class="brand brand--footer" href="#top"><span class="brand__mark">RA</span><span class="brand__name">{site.name}</span></a>
        <p>Software Engineer · Enterprise Applications · SaaS Builder</p>
      </div>
      <div class="footer__meta">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <a href="#top">Back to top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>
