---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { caseStudy, impactAreas, projects, site, skillGroups } from '../content/site';
---

<BaseLayout>
  <section class="hero shell" id="top" aria-labelledby="hero-title">
    <div class="hero__copy">
      <p class="hero__kicker"><span></span>Enterprise engineering · ERP automation · SaaS</p>
      <h1 id="hero-title">{site.name}</h1>
      <p class="hero__role">{site.role}</p>
      <p class="hero__statement">Building enterprise applications, ERP integrations, workflow automation, and <em>SaaS products.</em></p>
      <p class="hero__intro">
        I design and deliver production systems using .NET, Blazor, Angular, Azure, SQL Server,
        Oracle, and JDE EnterpriseOne. My work focuses on modernizing operational workflows,
        improving reliability, and turning complex business processes into maintainable software.
      </p>
      <div class="hero__actions">
        <a class="button button--primary" href="#work">View my work <span aria-hidden="true">↘</span></a>
        <a class="text-link" href={site.links.stockward} target="_blank" rel="noreferrer">Stockward <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={site.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a class="text-link" href={site.links.linkedin} target="_blank" rel="noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <aside class="hero__note" aria-label="Professional focus">
      <p>Currently focused on</p>
      <strong>Production applications, JDE automation, architecture guidance, and building Stockward.</strong>
      <span>5+ years of professional software development · Based in the United States.</span>
    </aside>
  </section>

  <section class="positioning" aria-label="Engineering focus">
    <div class="shell positioning__grid">
      {impactAreas.map((area) => (
        <article>
          <span>{area.number}</span>
          <h2>{area.title}</h2>
          <p>{area.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section shell about" id="about">
    <SectionHeading eyebrow="About" title="Engineering judgment grounded in production reality." />
    <div class="about__content">
      <p class="about__lead">
        I own and support business-critical applications from requirements and architecture through
        delivery, troubleshooting, and continued production operation.
      </p>
      <div class="about__details">
        <p>
          My work bridges modern full-stack development and established enterprise systems. I build
          .NET, Blazor, and Angular applications; connect them with Oracle, SQL Server, JDE
          EnterpriseOne, and JDE Orchestrator; and automate workflows that operational teams rely on.
        </p>
        <p>
          I also provide architecture guidance, code reviews, troubleshooting, testing support, and
          development guidance for other engineers. As founder and software architect of Stockward,
          I apply the same production discipline to a multi-tenant SaaS product.
        </p>
      </div>
    </div>
  </section>

  <section class="section work" id="work">
    <div class="shell">
      <SectionHeading
        eyebrow="Selected work"
        title="Systems, products, and engineering foundations."
        description="A focused view of the problems I take on. Employer and customer details are intentionally sanitized."
      />
      <div class="project-list">
        {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section shell case-study" id="case-study">
    <SectionHeading eyebrow="Case study · Sanitized" title={caseStudy.title} description={caseStudy.intro} />
    <div class="case-study__grid">
      {caseStudy.sections.map((section, index) => (
        <article>
          <span>{String(index + 1).padStart(2, '0')}</span>
          <h3>{section.label}</h3>
          <p>{section.content}</p>
          {section.items && <ul>{section.items.map((item) => <li>{item}</li>)}</ul>}
        </article>
      ))}
    </div>
  </section>

  <section class="section expertise" id="expertise">
    <div class="shell">
      <SectionHeading
        eyebrow="Expertise"
        title="A practical toolkit for durable software."
        description="Technology matters most in the context of sound boundaries, safe delivery, and clear business outcomes."
      />
      <div class="skills-grid">
        {skillGroups.map((group, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{group.title}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="contact shell" id="contact" aria-labelledby="contact-title">
    <p class="eyebrow">Start a conversation</p>
    <h2 id="contact-title">Building something that needs to work <em>for the long haul?</em></h2>
    <p>I’m interested in senior engineering, technical leadership, architecture, and thoughtful consulting conversations.</p>
    <div class="contact__actions">
      <a class="button button--light" href={site.links.linkedin} target="_blank" rel="noreferrer">Connect on LinkedIn <span aria-hidden="true">↗</span></a>
      <a class="text-link text-link--light" href={site.links.github} target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      <a class="text-link text-link--light" href={site.links.stockward} target="_blank" rel="noreferrer">Stockward <span aria-hidden="true">↗</span></a>
    </div>
  </section>

  <footer class="footer">
    <div class="shell footer__inner">
      <div>
        <a class="brand brand--footer" href="#top"><span class="brand__mark">RA</span><span class="brand__name">{site.name}</span></a>
        <p>Senior Software Engineer · Enterprise Applications · SaaS Builder</p>
      </div>
      <div class="footer__meta">
        <p>© {new Date().getFullYear()} {site.name}</p>
        <a href="#top">Back to top ↑</a>
      </div>
    </div>
  </footer>
</BaseLayout>
